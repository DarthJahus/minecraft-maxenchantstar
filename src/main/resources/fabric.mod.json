{
  "schemaVersion": 1,
  "id": "maxenchant",
  "version": "${version}",
  "name": "Max Enchant Star",
  "description": "Marks enchantments at their maximum level with a star wherever their name is displayed. Uses nomaxenchant's effective_max_levels channel when available; otherwise falls back to the local vanilla registry.",
  "authors": ["Jahus"],
  "contact": {
    "homepage": "https://mc.jahus.net/projects",
    "sources": "https://github.com/DarthJahus/minecraft-maxenchantstar",
    "issues": "https://github.com/DarthJahus/minecraft-maxenchantstar/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/maxenchant/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.jahus.maxenchant.client.MaxEnchantStarClient"
    ]
  },
  "mixins": [
    {
      "config": "maxenchant.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
